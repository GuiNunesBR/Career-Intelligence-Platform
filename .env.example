# Copy to .env and fill in. Never commit .env.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: primary model and the fallback used when it is overloaded or times out
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: HTTP port (default 3000)
# PORT=3000

# Optional: database location. SQLITE_URL takes any libsql URL and wins over SQLITE_FILE.
# Default: file:./sqlite.db
# SQLITE_URL=file:./sqlite.db
# SQLITE_FILE=./sqlite.db

# Production only: number of reverse proxies in front of the app (default 1)
# TRUST_PROXY_HOPS=1

# Development only: set to true to turn off Vite HMR and file watching
# DISABLE_HMR=false
